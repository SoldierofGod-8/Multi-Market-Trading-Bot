# Copy this file to .env and fill in. NEVER commit .env or share your keys.
# --- Crypto (ccxt). Only needed for LIVE crypto trading. ---
# Create the key on your exchange with TRADE permission and WITHDRAWALS DISABLED.
CCXT_API_KEY=
CCXT_SECRET=

# --- Forex/metals (MetaTrader 5). Optional: if empty, the bot uses the logged-in MT5 terminal. ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
